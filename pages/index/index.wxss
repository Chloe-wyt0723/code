.page { padding: 30rpx 34rpx 70rpx; }
.brand-row { display: flex; align-items: center; height: 92rpx; }
.brand-mark { display: block; width: 88rpx; height: 88rpx; flex-shrink: 0; }
.brand-name { margin-left: 18rpx; font-size: 42rpx; font-weight: 800; }
.profile { margin-left: auto; padding: 13rpx 22rpx; border: 2rpx solid #dfe7df; border-radius: 50rpx; color: #3d564b; background: #fff; font-size: 28rpx; }
.intro { display: flex; flex-direction: column; margin: 50rpx 0 34rpx; }
.title { font-size: 68rpx; font-weight: 800; line-height: 1.2; }
.subtitle { margin-top: 18rpx; color: #65776f; font-size: 36rpx; line-height: 1.55; }
.start-card { padding: 38rpx 34rpx; border-radius: 34rpx; color: #fff; background: linear-gradient(135deg,#226849,#39845d); box-shadow: 0 22rpx 50rpx rgba(32,93,64,.12); }
.start-row { display: flex; align-items: center; }
.camera-icon { display: flex; width: 126rpx; height: 126rpx; flex-shrink: 0; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,.35); border-radius: 36rpx; background: rgba(255,255,255,.12); font-size: 64rpx; }
.start-copy { display: flex; flex-direction: column; margin-left: 24rpx; }
.start-title { font-size: 40rpx; font-weight: 800; }
.start-desc { margin-top: 12rpx; color: #e0f0e6; font-size: 30rpx; line-height: 1.45; }
.primary,.save { display: flex; align-items: center; justify-content: center; width: 100%; height: 136rpx; margin-top: 34rpx; border: 0; border-radius: 28rpx; color: #174f39; background: #fff; box-shadow: 0 6rpx 0 #c8ddd0; font-size: 44rpx; font-weight: 800; }
.primary::after,.save::after { border: 0; }
.section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 54rpx 4rpx 22rpx; font-size: 40rpx; font-weight: 800; }
.section-meta { color: #65776f; font-size: 27rpx; font-weight: 400; }
.latest-card,.history-card { padding: 32rpx; border: 2rpx solid #dfe7df; border-radius: 30rpx; background: #fff; }
.record-time { color: #65776f; font-size: 28rpx; }
.reading { display: flex; align-items: baseline; gap: 14rpx; margin-top: 24rpx; font-size: 92rpx; font-weight: 800; line-height: 1; }
.slash { color: #b2beb5; font-size: 60rpx; font-weight: 400; }
.unit { color: #65776f; font-size: 28rpx; font-weight: 400; }
.pulse-row { display: flex; justify-content: space-between; margin-top: 28rpx; padding-top: 24rpx; border-top: 2rpx solid #edf0ed; color: #65776f; font-size: 32rpx; }
.pulse-value { color: #18352d; font-size: 36rpx; font-weight: 700; }
.record-actions { display:flex; justify-content:flex-end; margin-top:22rpx; }
.delete-record { box-sizing:border-box; display:flex; width:auto; min-width:112rpx; height:64rpx; flex-shrink:0; align-items:center; justify-content:center; margin:0; padding:0 18rpx; border:2rpx solid #ead3d0; border-radius:18rpx; color:#a83c34; background:#fff7f6; font-size:26rpx; line-height:1; }
.delete-record::after { border:0; }
.history-card .delete-record { width:76rpx; min-width:76rpx; height:56rpx; padding:0 8rpx; font-size:23rpx; }
.empty { padding: 36rpx 26rpx; border: 2rpx dashed #cdd9cf; border-radius: 28rpx; color: #65776f; background: #fbfcf9; text-align: center; font-size: 30rpx; line-height: 1.5; }
.history-list { display: flex; flex-direction: column; gap: 18rpx; }
.history-card { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-main { display:flex; flex:1; min-width:0; align-items:center; justify-content:space-between; gap:12rpx; }
.history-pulse { display: block; margin-top: 10rpx; color: #65776f; font-size: 26rpx; }
.history-reading { flex-shrink: 0; font-size: 36rpx; font-weight: 800; }
.tip { display: flex; flex-direction: column; gap: 10rpx; margin-top: 34rpx; padding: 28rpx 32rpx; border-radius: 26rpx; color: #3d594a; background: #eaf2e9; font-size: 29rpx; line-height: 1.6; }
.tip-title { color: #174f39; font-size: 34rpx; font-weight: 800; }
.mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; padding: 20rpx; background: rgba(18,37,29,.82); }
.dialog { box-sizing: border-box; width: 100%; height: 90vh; max-height: 90vh; padding: 34rpx 30rpx 30rpx; border-radius: 38rpx; background: #fff; }
.dialog-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.dialog-heading view { display: flex; flex-direction: column; }
.dialog-title { font-size: 44rpx; font-weight: 800; }
.dialog-subtitle { margin-top: 12rpx; color: #65776f; font-size: 28rpx; line-height: 1.5; }
.close { display:flex; box-sizing:border-box; width:76rpx; min-width:76rpx; height:76rpx; flex:0 0 76rpx; align-items:center; justify-content:center; margin:0; border: 0; border-radius: 50%; color: #3e5148; background: #f0f3ef; font-size: 54rpx; line-height: 1; }
.close::after { border: 0; }
.photo-preview { width: 100%; height: 330rpx; margin-top: 22rpx; border-radius: 22rpx; background: #f7f9f6; }
.hint { display: block; margin-top: 22rpx; color: #53685c; font-size: 28rpx; line-height: 1.55; }
.bp-alert { display:flex; flex-direction:column; gap:8rpx; margin-top:20rpx; padding:22rpx 24rpx; border:2rpx solid #f0c7bd; border-radius:20rpx; color:#8c3028; background:#fff1ed; font-size:28rpx; line-height:1.5; }
.bp-alert-title { font-size:30rpx; font-weight:800; }
.fields { display: flex; gap: 14rpx; margin-top: 26rpx; }
.fields label { flex: 1; min-width: 0; color: #53665a; font-size: 26rpx; line-height: 1.4; }
.fields input { box-sizing: border-box; width: 100%; height: 112rpx; margin-top: 12rpx; padding: 0 16rpx; border: 2rpx solid #cbd7ce; border-radius: 22rpx; color: #18352d; background: #fff; font-size: 42rpx; font-weight: 700; }
.save { height: 124rpx; color: #fff; background: #236b4d; box-shadow: 0 6rpx 0 #174f39; font-size: 40rpx; }
.privacy { display: block; margin-top: 22rpx; color: #65776f; font-size: 24rpx; line-height: 1.55; text-align: center; }
@media (min-width: 700px) { .page { max-width: 850rpx; margin: 0 auto; } .mask { align-items: center; justify-content: center; } .dialog { max-width: 700rpx; } }

.manual,.album { margin-top:18rpx; border:2rpx solid #cbd7ce; border-radius:24rpx; color:#174f39; background:#fff; font-size:32rpx; }
.cancel { margin-top:22rpx; border:0; color:#53685c; background:#f0f3ef; font-size:30rpx; }
.cancel::after { border:0; }

.rephoto { margin-top: 18rpx; border: 2rpx solid #cbd7ce; color: #174f39; background: #fff; font-size: 30rpx; }
.rephoto::after { border: 0; }

.primary,.manual,.album,.rephoto,.save,.cancel { box-sizing:border-box; display:flex; width:88%; margin-left:auto; margin-right:auto; align-items:center; justify-content:center; text-align:center; }
.dialog .rephoto,.dialog .album { height:100rpx; margin-left:auto; margin-right:auto; padding:0 16rpx; border:2rpx solid #cbd7ce; border-radius:24rpx; font-size:30rpx; }
