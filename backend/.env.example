# 腾讯云 OCR 密钥，请在本地 .env 文件中替换为真实值。
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key

# 可选项；省略时默认使用 ap-guangzhou。
TENCENTCLOUD_REGION=ap-guangzhou

# 可选项；省略时默认使用 3000。
PORT=3000

# 可选项：指定用于 OpenCV 图像预处理的 Python 可执行程序。
# Windows 默认使用 python，其他平台默认使用 python3。
# PYTHON_BIN=python3
